{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "postUpdateOptions": ["uvLockFileMaintenance"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Agrupa updates de github-actions num PR só",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Auto-merge só de patch em libs Python",
      "matchManagers": ["pip", "uv"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Minor de libs Python vira PR para o automerge.yml decidir após CI",
      "matchManagers": ["pip", "uv"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ]
}
